@model EducationFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit qualification" : "New qualification";
    ViewData["Section"] = "Portfolio";
}
<div class="admin-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Only record qualifications that were completed or are genuinely in progress.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-secondary btn-sm" href="/Admin/Education"><partial name="_Icon" model="@("arrow-left")" /> Back</a>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="Education" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)"
      class="admin-card admin-form" data-track-dirty>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert" style="margin:1.25rem 1.25rem 0"></div>

    <div class="form-section">
        <h2>Qualification</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Institution">Institution <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="Institution" required maxlength="200" />
                <span class="field-error" asp-validation-for="Institution"></span>
            </div>
            <div class="field">
                <label asp-for="InstitutionBn">Institution (Bangla)</label>
                <input asp-for="InstitutionBn" maxlength="240" lang="bn" />
                <span class="field-error" asp-validation-for="InstitutionBn"></span>
            </div>
            <div class="field">
                <label asp-for="Qualification">Qualification</label>
                <input asp-for="Qualification" maxlength="160" placeholder="B.Sc. in Computer Science" />
                <span class="field-error" asp-validation-for="Qualification"></span>
            </div>
            <div class="field">
                <label asp-for="QualificationBn">Qualification (Bangla)</label>
                <input asp-for="QualificationBn" maxlength="200" lang="bn" />
                <span class="field-error" asp-validation-for="QualificationBn"></span>
            </div>
            <div class="field">
                <label asp-for="Subject">Subject</label>
                <input asp-for="Subject" maxlength="160" />
                <span class="field-error" asp-validation-for="Subject"></span>
            </div>
            <div class="field">
                <label asp-for="Result">Result / GPA</label>
                <input asp-for="Result" maxlength="80" placeholder="CGPA 3.75 / 4.00" />
                <span class="hint">Leave empty if you do not want to publish it.</span>
                <span class="field-error" asp-validation-for="Result"></span>
            </div>
            <div class="field">
                <label asp-for="StartDate">Start date</label>
                <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            </div>
            <div class="field">
                <label asp-for="EndDate">Completion date</label>
                <input asp-for="EndDate" id="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
            </div>
        </div>
        <div class="check-grid">
            <div class="check-card">
                <input asp-for="IsCurrent" data-current-toggle="EndDate" />
                <label for="IsCurrent">Currently studying</label>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Description</h2>
        <div class="form-grid">
            <div class="field span-2">
                <label asp-for="Description">Description (English, Markdown)</label>
                <textarea asp-for="Description" rows="4"></textarea>
            </div>
            <div class="field span-2">
                <label asp-for="DescriptionBn">Description (Bangla, Markdown)</label>
                <textarea asp-for="DescriptionBn" rows="3" lang="bn"></textarea>
            </div>
            <div class="field span-2">
                <label asp-for="Achievements">Achievements (Markdown)</label>
                <textarea asp-for="Achievements" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Publishing</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContentStatus>()"></select>
            </div>
            <div class="field">
                <label asp-for="DisplayOrder">Display order</label>
                <input asp-for="DisplayOrder" type="number" min="0" max="999" />
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-ghost" href="/Admin/Education">Cancel</a>
        <button class="btn btn-primary" type="submit" data-submit-once data-loading-label="Saving…">
            <span class="btn-label">@(isEdit ? "Save changes" : "Create record")</span>
        </button>
    </div>
</form>
