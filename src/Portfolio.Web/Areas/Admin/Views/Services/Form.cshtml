@model ServiceFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit service" : "New service";
    ViewData["Section"] = "Portfolio";
    var icons = ViewData["Icons"] as string[] ?? IconCatalog.Names;
}
<div class="admin-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Only publish prices and commitments you are prepared to honour.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-secondary btn-sm" href="/Admin/Services"><partial name="_Icon" model="@("arrow-left")" /> Back</a>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="Services" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)"
      class="admin-card admin-form" data-track-dirty>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert" style="margin:1.25rem 1.25rem 0"></div>

    <div class="form-section">
        <div class="form-grid">
            <div class="field">
                <label asp-for="Title">Title (English) <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="Title" required maxlength="160" />
                <span class="field-error" asp-validation-for="Title"></span>
            </div>
            <div class="field">
                <label asp-for="TitleBn">Title (Bangla)</label>
                <input asp-for="TitleBn" maxlength="200" lang="bn" />
                <span class="field-error" asp-validation-for="TitleBn"></span>
            </div>
            <div class="field span-2">
                <label asp-for="Description">Description (English)</label>
                <textarea asp-for="Description" rows="4" maxlength="1000"></textarea>
                <span class="field-error" asp-validation-for="Description"></span>
            </div>
            <div class="field span-2">
                <label asp-for="DescriptionBn">Description (Bangla)</label>
                <textarea asp-for="DescriptionBn" rows="3" maxlength="1200" lang="bn"></textarea>
                <span class="field-error" asp-validation-for="DescriptionBn"></span>
            </div>
            <div class="field">
                <label asp-for="IconName">Icon</label>
                <select asp-for="IconName">
                    <option value="">Default</option>
                    @foreach (var icon in icons)
                    {
                        <option value="@icon" selected="@(Model.IconName == icon)">@icon</option>
                    }
                </select>
            </div>
            <div class="field">
                <label asp-for="DisplayOrder">Display order</label>
                <input asp-for="DisplayOrder" type="number" min="0" max="999" />
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Pricing and call to action</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="StartingPrice">Starting price</label>
                <input asp-for="StartingPrice" type="number" step="0.01" min="0" />
                <span class="hint">Leave empty to hide pricing entirely.</span>
                <span class="field-error" asp-validation-for="StartingPrice"></span>
            </div>
            <div class="field">
                <label asp-for="Currency">Currency</label>
                <input asp-for="Currency" maxlength="10" placeholder="USD" />
                <span class="field-error" asp-validation-for="Currency"></span>
            </div>
            <div class="field">
                <label asp-for="CtaLabel">CTA label</label>
                <input asp-for="CtaLabel" maxlength="60" placeholder="Start a project" />
                <span class="field-error" asp-validation-for="CtaLabel"></span>
            </div>
            <div class="field">
                <label asp-for="CtaUrl">CTA destination</label>
                <input asp-for="CtaUrl" maxlength="300" placeholder="/contact" />
                <span class="field-error" asp-validation-for="CtaUrl"></span>
            </div>
        </div>
        <div class="check-grid">
            <div class="check-card">
                <input asp-for="IsVisible" />
                <label for="IsVisible">Visible on the public website</label>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-ghost" href="/Admin/Services">Cancel</a>
        <button class="btn btn-primary" type="submit" data-submit-once data-loading-label="Saving…">
            <span class="btn-label">@(isEdit ? "Save changes" : "Create service")</span>
        </button>
    </div>
</form>
