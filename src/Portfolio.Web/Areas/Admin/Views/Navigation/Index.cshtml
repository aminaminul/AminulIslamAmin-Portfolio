@model IReadOnlyList<NavigationItem>
@{
    ViewData["Title"] = "Navigation & footer";
    ViewData["Section"] = "Site";
}
<div class="admin-page-head">
    <div>
        <h1>Navigation &amp; footer</h1>
        <p>Control menu labels, destinations, ordering and visibility. Hidden links and disabled sections are never advertised.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-primary btn-sm" href="/Admin/Navigation/Create"><partial name="_Icon" model="@("plus")" /> Add link</a>
    </div>
</div>

<div class="admin-card">
    @if (Model.Count == 0)
    {
        <div class="admin-card-body">
            <partial name="_Empty" model="@(new EmptyStateModel("No navigation links", "Add links so visitors can move between sections.", "menu", "/Admin/Navigation/Create", "Add link"))" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:80px">Order</th>
                        <th>Label</th>
                        <th>Destination</th>
                        <th style="width:120px">Placement</th>
                        <th style="width:110px">Status</th>
                        <th style="width:220px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-actions" style="justify-content:flex-start">
                                    <form method="post" asp-action="Move" asp-route-id="@item.Id" asp-route-direction="-1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move up"><partial name="_Icon" model="@("arrow-up")" /></button>
                                    </form>
                                    <form method="post" asp-action="Move" asp-route-id="@item.Id" asp-route-direction="1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move down"><partial name="_Icon" model="@("arrow-down")" /></button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title">
                                    <strong>@item.Label</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.LabelBn))
                                    {
                                        <span lang="bn">@item.LabelBn</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-muted">@item.Url</td>
                            <td class="cell-muted">@(item.ShowInFooter ? "Footer" : "Header")</td>
                            <td>
                                @if (item.IsVisible) { <span class="badge badge-visible">Visible</span> }
                                else { <span class="badge badge-hidden">Hidden</span> }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a class="icon-action" href="/Admin/Navigation/Edit/@item.Id" aria-label="Edit"><partial name="_Icon" model="@("edit")" /></a>
                                    <form method="post" asp-action="ToggleVisible" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="@(item.IsVisible ? "Hide" : "Show")"><partial name="_Icon" model="@("eye")" /></button>
                                    </form>
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" data-confirm="Delete this navigation link?">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action danger" type="submit" aria-label="Delete"><partial name="_Icon" model="@("trash")" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="form-note" style="margin-top:1rem">
    If every navigation link is deleted, the public site falls back to a standard set of section links. Add your own links to control ordering and labels.
</div>
