@model IReadOnlyList<Skill>
@{
    ViewData["Title"] = "Skills";
    ViewData["Section"] = "Portfolio";
    var categories = ViewData["Categories"] as IReadOnlyList<SkillCategory> ?? [];
    var q = ViewData["Q"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
}
<div class="admin-page-head">
    <div>
        <h1>Skills</h1>
        <p>Skills are grouped by category. Proficiency indicators appear only when a value is supplied.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-secondary btn-sm" href="/Admin/Skills/Categories"><partial name="_Icon" model="@("layers")" /> Categories</a>
        <a class="btn btn-primary btn-sm" href="/Admin/Skills/Create"><partial name="_Icon" model="@("plus")" /> New skill</a>
    </div>
</div>

<div class="admin-toolbar">
    <form class="admin-filters" method="get" action="/Admin/Skills" role="search">
        <label class="sr-only" for="skill-q">Search skills</label>
        <input id="skill-q" type="search" name="q" value="@q" placeholder="Search skills" />
        <label class="sr-only" for="skill-category">Filter by category</label>
        <select id="skill-category" name="categoryId">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(categoryId == category.Id)">@category.Name</option>
            }
        </select>
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (!string.IsNullOrWhiteSpace(q) || categoryId is not null)
        {
            <a class="btn btn-ghost" href="/Admin/Skills">Clear</a>
        }
    </form>
</div>

<div class="admin-card">
    @if (Model.Count == 0)
    {
        <div class="admin-card-body">
            <partial name="_Empty" model="@(new EmptyStateModel("No skills found", "Add skills and categories so visitors can see your technical range.", "layers", "/Admin/Skills/Create", "Add skill"))" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:90px">Order</th>
                        <th>Skill</th>
                        <th>Category</th>
                        <th style="width:110px">Level</th>
                        <th style="width:110px">Visibility</th>
                        <th style="width:200px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-actions" style="justify-content:flex-start">
                                    <form method="post" asp-action="Move" asp-route-id="@skill.Id" asp-route-direction="-1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move up" @(skill == Model.First() ? "disabled" : null)><partial name="_Icon" model="@("arrow-up")" /></button>
                                    </form>
                                    <form method="post" asp-action="Move" asp-route-id="@skill.Id" asp-route-direction="1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move down" @(skill == Model.Last() ? "disabled" : null)><partial name="_Icon" model="@("arrow-down")" /></button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title">
                                    <strong>@skill.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(skill.NameBn))
                                    {
                                        <span lang="bn">@skill.NameBn</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-muted">@(skill.Category?.Name ?? "Uncategorised")</td>
                            <td class="cell-muted">@(skill.Proficiency is null ? "—" : $"{skill.Proficiency}%")</td>
                            <td>
                                @if (skill.IsVisible) { <span class="badge badge-visible">Visible</span> }
                                else { <span class="badge badge-hidden">Hidden</span> }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a class="icon-action" href="/Admin/Skills/Edit/@skill.Id" aria-label="Edit"><partial name="_Icon" model="@("edit")" /></a>
                                    <form method="post" asp-action="Delete" asp-route-id="@skill.Id" data-confirm="Delete this skill?">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action danger" type="submit" aria-label="Delete"><partial name="_Icon" model="@("trash")" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
