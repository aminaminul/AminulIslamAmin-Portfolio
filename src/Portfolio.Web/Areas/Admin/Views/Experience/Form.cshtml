@model ExperienceFormModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit role" : "New role";
    ViewData["Section"] = "Portfolio";
}
<div class="admin-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Describe responsibilities and achievements honestly. Markdown is supported.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-secondary btn-sm" href="/Admin/Experience"><partial name="_Icon" model="@("arrow-left")" /> Back</a>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="Experience" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)"
      class="admin-card admin-form" data-track-dirty>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert" style="margin:1.25rem 1.25rem 0"></div>

    <div class="form-section">
        <h2>Role</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="JobTitle">Job title (English) <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="JobTitle" required maxlength="160" />
                <span class="field-error" asp-validation-for="JobTitle"></span>
            </div>
            <div class="field">
                <label asp-for="JobTitleBn">Job title (Bangla)</label>
                <input asp-for="JobTitleBn" maxlength="200" lang="bn" />
                <span class="field-error" asp-validation-for="JobTitleBn"></span>
            </div>
            <div class="field">
                <label asp-for="Company">Company / organisation <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="Company" required maxlength="160" />
                <span class="field-error" asp-validation-for="Company"></span>
            </div>
            <div class="field">
                <label asp-for="CompanyBn">Company (Bangla)</label>
                <input asp-for="CompanyBn" maxlength="200" lang="bn" />
                <span class="field-error" asp-validation-for="CompanyBn"></span>
            </div>
            <div class="field">
                <label asp-for="CompanyUrl">Company website</label>
                <input asp-for="CompanyUrl" type="url" maxlength="500" />
                <span class="field-error" asp-validation-for="CompanyUrl"></span>
            </div>
            <div class="field">
                <label asp-for="EmploymentType">Employment type</label>
                <select asp-for="EmploymentType">
                    <option value="">Not specified</option>
                    <option value="Full-time">Full-time</option>
                    <option value="Part-time">Part-time</option>
                    <option value="Contract">Contract</option>
                    <option value="Freelance">Freelance</option>
                    <option value="Internship">Internship</option>
                    <option value="Volunteer">Volunteer</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" maxlength="160" placeholder="City, Country or Remote" />
                <span class="field-error" asp-validation-for="Location"></span>
            </div>
            <div class="field">
                <label asp-for="StartDate">Start date <span class="required" aria-hidden="true">*</span></label>
                <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" required />
                <span class="field-error" asp-validation-for="StartDate"></span>
            </div>
            <div class="field">
                <label asp-for="EndDate">End date</label>
                <input asp-for="EndDate" id="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" />
                <span class="field-error" asp-validation-for="EndDate"></span>
            </div>
        </div>
        <div class="check-grid">
            <div class="check-card">
                <input asp-for="IsCurrent" data-current-toggle="EndDate" />
                <label for="IsCurrent">I currently work here</label>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Details</h2>
        <div class="form-grid">
            <div class="field span-2">
                <label asp-for="Responsibilities">Responsibilities (English, Markdown)</label>
                <textarea asp-for="Responsibilities" rows="5"></textarea>
                <span class="field-error" asp-validation-for="Responsibilities"></span>
            </div>
            <div class="field span-2">
                <label asp-for="ResponsibilitiesBn">Responsibilities (Bangla, Markdown)</label>
                <textarea asp-for="ResponsibilitiesBn" rows="4" lang="bn"></textarea>
            </div>
            <div class="field span-2">
                <label asp-for="Achievements">Achievements (English, Markdown)</label>
                <textarea asp-for="Achievements" rows="4"></textarea>
            </div>
            <div class="field span-2">
                <label asp-for="AchievementsBn">Achievements (Bangla, Markdown)</label>
                <textarea asp-for="AchievementsBn" rows="3" lang="bn"></textarea>
            </div>
            <div class="field span-2">
                <label asp-for="Technologies">Technologies</label>
                <input asp-for="Technologies" maxlength="400" placeholder="C#, SQL Server, Azure" />
                <span class="hint">Comma-separated.</span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <h2>Publishing</h2>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContentStatus>()"></select>
            </div>
            <div class="field">
                <label asp-for="DisplayOrder">Display order</label>
                <input asp-for="DisplayOrder" type="number" min="0" max="999" />
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-ghost" href="/Admin/Experience">Cancel</a>
        <button class="btn btn-primary" type="submit" data-submit-once data-loading-label="Saving…">
            <span class="btn-label">@(isEdit ? "Save changes" : "Create role")</span>
        </button>
    </div>
</form>
