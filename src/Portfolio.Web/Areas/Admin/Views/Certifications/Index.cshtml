@model AdminListViewModel<Certification>
@{
    ViewData["Title"] = "Certifications";
    ViewData["Section"] = "Portfolio";
    var statuses = new[] { ("", "All"), ("published", "Published"), ("draft", "Drafts") };
}
<div class="admin-page-head">
    <div>
        <h1>Certifications</h1>
        <p>Credentials and certificates. Only add verification links that actually resolve.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-primary btn-sm" href="/Admin/Certifications/Create"><partial name="_Icon" model="@("plus")" /> New certification</a>
    </div>
</div>

<div class="admin-toolbar">
    <div class="filter-tabs" role="group" aria-label="Filter by status">
        @foreach (var (value, label) in statuses)
        {
            <a class="filter-tab @(Model.Status == (string.IsNullOrEmpty(value) ? null : value) ? "is-active" : null)"
               href="@Url.Action("Index", "Certifications", new { q = Model.Q, status = string.IsNullOrEmpty(value) ? null : value })">@label</a>
        }
    </div>
    <form class="admin-filters" method="get" action="/Admin/Certifications" role="search">
        <label class="sr-only" for="cert-q">Search certifications</label>
        <input id="cert-q" type="search" name="q" value="@Model.Q" placeholder="Search title or issuer" />
        <input type="hidden" name="status" value="@Model.Status" />
        <button class="btn btn-secondary" type="submit">Search</button>
        @if (Model.HasFilters)
        {
            <a class="btn btn-ghost" href="/Admin/Certifications">Clear</a>
        }
    </form>
</div>

<div class="admin-card">
    @if (Model.Items.Count == 0)
    {
        <div class="admin-card-body">
            <partial name="_Empty" model="@(new EmptyStateModel("No certifications", "Add a verified certificate to show your credentials.", "award", "/Admin/Certifications/Create", "Add certification"))" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:80px">Order</th>
                        <th>Certification</th>
                        <th style="width:180px">Issuer</th>
                        <th style="width:150px">Dates</th>
                        <th style="width:110px">Status</th>
                        <th style="width:220px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="table-actions" style="justify-content:flex-start">
                                    <form method="post" asp-action="Move" asp-route-id="@item.Id" asp-route-direction="-1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move up"><partial name="_Icon" model="@("arrow-up")" /></button>
                                    </form>
                                    <form method="post" asp-action="Move" asp-route-id="@item.Id" asp-route-direction="1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move down"><partial name="_Icon" model="@("arrow-down")" /></button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title">
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.CredentialId))
                                    {
                                        <span>ID: @item.CredentialId</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-muted">@item.Issuer</td>
                            <td class="cell-muted">@item.IssueDate.FormatDate() @(item.ExpiryDate is null ? "" : $"→ {item.ExpiryDate.FormatDate()}")</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td>
                                <div class="table-actions">
                                    <a class="icon-action" href="/Admin/Certifications/Edit/@item.Id" aria-label="Edit"><partial name="_Icon" model="@("edit")" /></a>
                                    @if (item.Status == ContentStatus.Published)
                                    {
                                        <form method="post" asp-action="Unpublish" asp-route-id="@item.Id" data-confirm="Unpublish this certification?">
                                            @Html.AntiForgeryToken()
                                            <button class="icon-action" type="submit" aria-label="Unpublish"><partial name="_Icon" model="@("eye")" /></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Publish" asp-route-id="@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button class="icon-action" type="submit" aria-label="Publish"><partial name="_Icon" model="@("check")" /></button>
                                        </form>
                                    }
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" data-confirm="Delete this certification?">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action danger" type="submit" aria-label="Delete"><partial name="_Icon" model="@("trash")" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pager is not null)
        {
            <div class="admin-card-footer"><partial name="_Pager" model="Model.Pager" /></div>
        }
    }
</div>
