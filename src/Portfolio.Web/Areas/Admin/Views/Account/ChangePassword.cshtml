@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Account & security";
    ViewData["Section"] = "Account";
}
<div class="admin-page-head">
    <div>
        <h1>Account &amp; security</h1>
        <p>Signed in as <strong>@User.Identity?.Name</strong>. Passwords are hashed by ASP.NET Core Identity; sessions expire automatically.</p>
    </div>
</div>

<div class="admin-grid admin-grid-2">
    <section class="admin-card">
        <div class="admin-card-head">
            <div>
                <h2>Change password</h2>
                <p>Use at least 12 characters with upper and lower case, a number and a symbol.</p>
            </div>
        </div>
        <form method="post" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" class="admin-form">
            @Html.AntiForgeryToken()
            <div class="admin-card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
                <div class="form-grid">
                    <div class="field span-2">
                        <label asp-for="CurrentPassword">Current password</label>
                        <input asp-for="CurrentPassword" autocomplete="current-password" required />
                        <span class="field-error" asp-validation-for="CurrentPassword"></span>
                    </div>
                    <div class="field">
                        <label asp-for="NewPassword">New password</label>
                        <input asp-for="NewPassword" autocomplete="new-password" required />
                        <span class="field-error" asp-validation-for="NewPassword"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" required />
                        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>
            <div class="admin-card-footer">
                <button class="btn btn-primary" type="submit" data-submit-once data-loading-label="Saving…">
                    <span class="btn-label">Update password</span>
                </button>
            </div>
        </form>
    </section>

    <div class="admin-card">
        <div class="admin-card-head">
            <div>
                <h2>Sessions</h2>
                <p>Sign out of every other browser and device.</p>
            </div>
        </div>
        <div class="admin-card-body">
            <p class="hint" style="margin-bottom:1rem">
                This regenerates your security stamp. Other sessions will be required to sign in again;
                this browser stays signed in.
            </p>
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="SignOutEverywhere"
                  data-confirm="Sign out of all other sessions?">
                @Html.AntiForgeryToken()
                <button class="btn btn-secondary" type="submit">
                    <partial name="_Icon" model="@("shield")" />
                    Sign out other sessions
                </button>
            </form>
        </div>
        <div class="admin-card-footer" style="justify-content:flex-start">
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button class="btn btn-ghost btn-sm" type="submit">
                    <partial name="_Icon" model="@("log-out")" /> Sign out of this device
                </button>
            </form>
        </div>
    </div>
</div>
