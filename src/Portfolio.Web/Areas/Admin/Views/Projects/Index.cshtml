@model AdminListViewModel<Project>
@{
    ViewData["Title"] = "Projects";
    ViewData["Section"] = "Portfolio";
    var categories = ViewData["Categories"] as IReadOnlyList<string> ?? [];
    var statuses = new[] { ("", "All"), ("published", "Published"), ("draft", "Drafts"), ("archived", "Archived") };
}
<div class="admin-page-head">
    <div>
        <h1>Projects</h1>
        <p>Create case studies, upload screenshots and control exactly which projects visitors can see.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-primary btn-sm" href="/Admin/Projects/Create"><partial name="_Icon" model="@("plus")" /> New project</a>
    </div>
</div>

<div class="admin-toolbar">
    <div class="filter-tabs" role="group" aria-label="Filter by status">
        @foreach (var (value, label) in statuses)
        {
            <a class="filter-tab @(Model.Status == (string.IsNullOrEmpty(value) ? null : value) ? "is-active" : null)"
               href="@Url.Action("Index", "Projects", new { q = Model.Q, category = Model.Filter, status = string.IsNullOrEmpty(value) ? null : value })">@label</a>
        }
    </div>
    <form class="admin-filters" method="get" action="/Admin/Projects" role="search">
        <label class="sr-only" for="project-q">Search projects</label>
        <input id="project-q" type="search" name="q" value="@Model.Q" placeholder="Search title or slug" />
        <label class="sr-only" for="project-category">Category</label>
        <select id="project-category" name="category">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category" selected="@(Model.Filter == category)">@category</option>
            }
        </select>
        <input type="hidden" name="status" value="@Model.Status" />
        <button class="btn btn-secondary" type="submit">Filter</button>
        @if (Model.HasFilters)
        {
            <a class="btn btn-ghost" href="/Admin/Projects">Clear</a>
        }
    </form>
</div>

<div class="admin-card">
    @if (Model.Items.Count == 0)
    {
        <div class="admin-card-body">
            <partial name="_Empty" model="@(new EmptyStateModel("No projects found", "Add your first project or adjust the filters.", "box", "/Admin/Projects/Create", "New project"))" />
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:80px">Order</th>
                        <th>Project</th>
                        <th>Category</th>
                        <th style="width:110px">Stage</th>
                        <th style="width:110px">Status</th>
                        <th style="width:300px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="table-actions" style="justify-content:flex-start">
                                    <form method="post" asp-action="Move" asp-route-id="@project.Id" asp-route-direction="-1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move up"><partial name="_Icon" model="@("arrow-up")" /></button>
                                    </form>
                                    <form method="post" asp-action="Move" asp-route-id="@project.Id" asp-route-direction="1">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="Move down"><partial name="_Icon" model="@("arrow-down")" /></button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="cell-title">
                                    <strong>@project.Title</strong>
                                    <span>/projects/@project.Slug</span>
                                </div>
                                @if (project.IsFeatured)
                                {
                                    <span class="badge badge-featured" style="margin-top:0.3rem">Featured</span>
                                }
                            </td>
                            <td class="cell-muted">@(project.Category ?? "—")</td>
                            <td class="cell-muted">@project.Stage</td>
                            <td><partial name="_StatusBadge" model="project.Status" /></td>
                            <td>
                                <div class="table-actions">
                                    <a class="icon-action" href="/Admin/Projects/Preview/@project.Id" target="_blank" aria-label="Preview"><partial name="_Icon" model="@("eye")" /></a>
                                    <a class="icon-action" href="/Admin/Projects/Images/@project.Id" aria-label="Gallery"><partial name="_Icon" model="@("image")" /></a>
                                    <a class="icon-action" href="/Admin/Projects/Edit/@project.Id" aria-label="Edit"><partial name="_Icon" model="@("edit")" /></a>
                                    <form method="post" asp-action="ToggleFeatured" asp-route-id="@project.Id">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action" type="submit" aria-label="@(project.IsFeatured ? "Remove from featured" : "Mark as featured")"><partial name="_Icon" model="@("star")" /></button>
                                    </form>
                                    @if (project.Status == ContentStatus.Published)
                                    {
                                        <form method="post" asp-action="Unpublish" asp-route-id="@project.Id" data-confirm="Unpublish this project? It will disappear from the public website.">
                                            @Html.AntiForgeryToken()
                                            <button class="icon-action" type="submit" aria-label="Unpublish"><partial name="_Icon" model="@("eye")" /></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Publish" asp-route-id="@project.Id">
                                            @Html.AntiForgeryToken()
                                            <button class="icon-action" type="submit" aria-label="Publish"><partial name="_Icon" model="@("check")" /></button>
                                        </form>
                                    }
                                    <form method="post" asp-action="Delete" asp-route-id="@project.Id"
                                          data-confirm="Delete this project permanently? Its gallery links are removed; media files stay in the library.">
                                        @Html.AntiForgeryToken()
                                        <button class="icon-action danger" type="submit" aria-label="Delete"><partial name="_Icon" model="@("trash")" /></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pager is not null)
        {
            <div class="admin-card-footer">
                <partial name="_Pager" model="Model.Pager" />
            </div>
        }
    }
</div>
