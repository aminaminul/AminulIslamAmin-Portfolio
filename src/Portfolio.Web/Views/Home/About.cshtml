@model AboutViewModel
@inject IMarkdownService Markdown
@{
    var profile = Model.Profile;
    var settings = Model.Settings;
    var name = profile.DisplayName(settings);
    var role = profile.ProfessionalTitle.PickOptional(profile.ProfessionalTitleBn);
    var intro = profile.ShortIntro.PickOptional(profile.ShortIntroBn);
    var hasExperience = Model.Experience.Count > 0;
    var hasEducation = Model.Education.Count > 0;
    var hasCertifications = Model.Certifications.Count > 0;
    var hasAchievements = Model.Achievements.Count > 0;
}
<section class="page-hero">
    <div class="container page-hero-inner">
        <div>
            <p class="section-eyebrow">@L["About"]</p>
            <h1 class="page-title">@name</h1>
            @if (!string.IsNullOrWhiteSpace(role))
            {
                <p class="page-role">@role</p>
            }
            @if (!string.IsNullOrWhiteSpace(intro))
            {
                <p class="page-lead">@intro</p>
            }
            <div class="page-actions">
                @if (settings.ShowResumeSection && settings.ResumeMediaId is not null)
                {
                    <a class="btn btn-primary btn-sm" href="/cv">
                        <partial name="_Icon" model="@("download")" />
                        <span>@settings.ResumeButtonLabel.Pick(settings.ResumeButtonLabelBn)</span>
                    </a>
                }
                <a class="btn btn-secondary btn-sm" href="/contact">@L["Get in touch"]</a>
            </div>
        </div>
        @if (profile.PhotoMediaId is not null)
        {
            <figure class="page-hero-photo">
                <img src="/media/@profile.PhotoMediaId" alt="@(profile.PhotoAlt ?? name)" loading="lazy" width="360" height="420" />
            </figure>
        }
    </div>
</section>

<section class="section">
    <div class="container">
        @if (Model.Sections.Count > 0)
        {
            <div class="about-sections">
                @foreach (var block in Model.Sections)
                {
                    <article class="about-block @(block.Image is not null ? "has-media" : null)" data-reveal>
                        <div>
                            <h2 class="section-title">@block.Title.Pick(block.TitleBn)</h2>
                            <div class="prose">
                                @Html.Raw(Markdown.ToHtml(ContentLocalization.IsBangla && block.BodyBn is not null ? block.BodyBn : block.Body))
                            </div>
                        </div>
                        @if (block.Image is not null)
                        {
                            <figure class="about-block-media">
                                <img src="/media/@block.Image.Id" alt="@(block.Image.AltText ?? block.Title)" loading="lazy" width="520" height="400" />
                            </figure>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <partial name="_Empty" model="@(new EmptyStateModel(L["Biography coming soon"].Value, L["The owner has not published an about section yet."].Value, "user"))" />
        }
    </div>
</section>

@if (hasExperience)
{
    <section class="section section-alt" id="experience">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="section-eyebrow">@L["Experience"]</p>
                    <h2 class="section-title">@L["Professional experience"]</h2>
                </div>
            </div>
            <ol class="timeline timeline-lg">
                @foreach (var job in Model.Experience)
                {
                    <li class="timeline-item" data-reveal>
                        <span class="timeline-dot" aria-hidden="true"></span>
                        <div class="timeline-card">
                            <div class="timeline-head">
                                <div>
                                    <h3>@job.JobTitle.Pick(job.JobTitleBn)</h3>
                                    <p class="timeline-company">
                                        @if (!string.IsNullOrWhiteSpace(job.CompanyUrl))
                                        {
                                            <a href="@job.CompanyUrl" target="_blank" rel="noopener noreferrer">@job.Company.Pick(job.CompanyBn)</a>
                                        }
                                        else
                                        {
                                            @job.Company.Pick(job.CompanyBn)
                                        }
                                        @if (!string.IsNullOrWhiteSpace(job.EmploymentType))
                                        {
                                            <span class="muted"> · @job.EmploymentType</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(job.Location))
                                        {
                                            <span class="muted"> · @job.Location</span>
                                        }
                                    </p>
                                </div>
                                <p class="timeline-dates">@job.StartDate.FormatDateRange(job.EndDate, job.IsCurrent)</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(job.Responsibilities))
                            {
                                <div class="prose prose-sm">
                                    @Html.Raw(Markdown.ToHtml(ContentLocalization.IsBangla && job.ResponsibilitiesBn is not null ? job.ResponsibilitiesBn : job.Responsibilities))
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(job.Achievements))
                            {
                                <div class="timeline-achievements">
                                    <h4>@L["Selected achievements"]</h4>
                                    <div class="prose prose-sm">
                                        @Html.Raw(Markdown.ToHtml(ContentLocalization.IsBangla && job.AchievementsBn is not null ? job.AchievementsBn : job.Achievements))
                                    </div>
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>
}

@if (hasEducation)
{
    <section class="section" id="education">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="section-eyebrow">@L["Education"]</p>
                    <h2 class="section-title">@L["Academic background"]</h2>
                </div>
            </div>
            <div class="education-grid">
                @foreach (var item in Model.Education)
                {
                    <article class="education-card" data-reveal>
                        <span class="icon-badge" aria-hidden="true"><partial name="_Icon" model="@("graduation-cap")" /></span>
                        <h3>@(item.Qualification.PickOptional(item.QualificationBn) ?? item.Institution.Pick(item.InstitutionBn))</h3>
                        @if (!string.IsNullOrWhiteSpace(item.Qualification))
                        {
                            <p class="education-institution">@item.Institution.Pick(item.InstitutionBn)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Subject))
                        {
                            <p class="muted">@item.Subject</p>
                        }
                        <p class="education-meta">
                            @if (item.StartDate is not null || item.EndDate is not null)
                            {
                                <span>@(item.StartDate.FormatDate()) — @(item.IsCurrent ? L["Present"].Value : item.EndDate.FormatDate())</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Result))
                            {
                                <span class="result-badge">@item.Result</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <div class="prose prose-sm">
                                @Html.Raw(Markdown.ToHtml(ContentLocalization.IsBangla && item.DescriptionBn is not null ? item.DescriptionBn : item.Description))
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (hasCertifications)
{
    <section class="section section-alt" id="certifications">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="section-eyebrow">@L["Certifications"]</p>
                    <h2 class="section-title">@L["Certifications & credentials"]</h2>
                </div>
            </div>
            <div class="cert-grid">
                @foreach (var cert in Model.Certifications)
                {
                    <article class="cert-card" data-reveal>
                        @if (cert.ImageMediaId is not null)
                        {
                            <span class="icon-badge icon-badge-image" aria-hidden="true"><img src="/media/@cert.ImageMediaId" alt="" loading="lazy" /></span>
                        }
                        else
                        {
                            <span class="icon-badge" aria-hidden="true"><partial name="_Icon" model="@("award")" /></span>
                        }
                        <h3>@cert.Title.Pick(cert.TitleBn)</h3>
                        <p class="muted">@cert.Issuer</p>
                        <p class="cert-meta">
                            @if (cert.IssueDate is not null)
                            {
                                <span>@L["Issued"] @cert.IssueDate.FormatDate()</span>
                            }
                            @if (cert.ExpiryDate is not null)
                            {
                                <span>@L["Expires"] @cert.ExpiryDate.FormatDate()</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(cert.Description))
                        {
                            <p class="card-text">@cert.Description.Pick(cert.DescriptionBn)</p>
                        }
                        <div class="cert-links">
                            @if (!string.IsNullOrWhiteSpace(cert.VerificationUrl))
                            {
                                <a class="text-link" href="@cert.VerificationUrl" target="_blank" rel="noopener noreferrer">
                                    @L["Verify credential"] <partial name="_Icon" model="@("external-link")" />
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(cert.CredentialId))
                            {
                                <span class="credential-id">@L["ID"]: @cert.CredentialId</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (hasAchievements)
{
    <section class="section" id="achievements">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="section-eyebrow">@L["Achievements"]</p>
                    <h2 class="section-title">@L["Achievements"]</h2>
                </div>
            </div>
            <div class="achievement-list">
                @foreach (var item in Model.Achievements)
                {
                    <article class="achievement-item" data-reveal>
                        @if (item.ImageMediaId is not null)
                        {
                            <span class="icon-badge icon-badge-image" aria-hidden="true"><img src="/media/@item.ImageMediaId" alt="" loading="lazy" /></span>
                        }
                        <span class="achievement-date">@item.AchievementDate.FormatDate()</span>
                        <div>
                            <h3>@item.Title.Pick(item.TitleBn)</h3>
                            @if (!string.IsNullOrWhiteSpace(item.IssuingOrganization))
                            {
                                <p class="muted">@item.IssuingOrganization</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p>@item.Description.Pick(item.DescriptionBn)</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ExternalUrl))
                            {
                                <a class="text-link" href="@item.ExternalUrl" target="_blank" rel="noopener noreferrer">@L["More details"] <partial name="_Icon" model="@("external-link")" /></a>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (settings.ShowResumeSection && settings.ResumeMediaId is not null)
{
    <section class="section">
        <div class="container">
            <div class="cta-panel">
                <div>
                    <p class="section-eyebrow">@L["Resume"]</p>
                    <h2>@(settings.ResumeHeadline.PickOptional(settings.ResumeHeadlineBn) ?? L["A complete overview of my experience"].Value)</h2>
                </div>
                <div class="cta-actions">
                    <a class="btn btn-primary" href="/cv">
                        <partial name="_Icon" model="@("download")" />
                        <span>@settings.ResumeButtonLabel.Pick(settings.ResumeButtonLabelBn)</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
}
