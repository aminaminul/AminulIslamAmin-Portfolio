@model ErrorViewModel
<section class="error-page">
    <div class="container error-inner">
        <p class="error-code" aria-hidden="true">@Model.StatusCode</p>
        <h1>@Model.Title</h1>
        <p class="page-lead">@Model.Message</p>
        <div class="page-actions">
            <a class="btn btn-primary" href="/">@L["Back to home"]</a>
            <a class="btn btn-secondary" href="/contact">@L["Contact"]</a>
        </div>
    </div>
</section>
